diff --git a/build/config/clang/BUILD.gn b/build/config/clang/BUILD.gn
index d3054d14d9c62a9a3f864925d752326f0e35cac5..7b193dbc1c90e8dd270f1eca53c9b19e2a022437 100644
--- a/build/config/clang/BUILD.gn
+++ b/build/config/clang/BUILD.gn
@@ -129,6 +129,8 @@ template("clang_lib") {
           _dir = "armv7-unknown-linux-gnueabihf"
         } else if (current_cpu == "arm64") {
           _dir = "aarch64-unknown-linux-gnu"
+        } else if (current_cpu == "loong64") {
+          _dir = "loongarch64-unknown-linux-gnu"
         } else {
           assert(false)  # Unhandled cpu type
         }
diff --git a/build/config/compiler/BUILD.gn b/build/config/compiler/BUILD.gn
index 89b4755ac8b39a3644c25bd9a680ca277802a84c..093a8986100d093a39799213b3e7cb3159e0e753 100644
--- a/build/config/compiler/BUILD.gn
+++ b/build/config/compiler/BUILD.gn
@@ -1449,6 +1449,7 @@ config("compiler_cpu_abi") {
         "-mabi=lp64d",
         "-mcmodel=medium",
       ]
+      rustflags = [ "-Ccode-model=large" ]
     } else if (current_cpu == "s390x") {
       cflags += [ "-m64" ]
       ldflags += [ "-m64" ]
@@ -1731,9 +1732,9 @@ config("treat_warnings_as_errors") {
 # subconfig of both chromium_code and no_chromium_code.  This way these
 # flags are guaranteed to appear on the compile command line after -Wall.
 config("default_warnings") {
-  cflags = []
-  cflags_c = []
-  cflags_cc = []
+  cflags = [ "-Wno-c++11-narrowing-const-reference" ]
+  cflags_c = [ "-Wno-c++11-narrowing-const-reference" ]
+  cflags_cc = [ "-Wno-c++11-narrowing-const-reference" ]
   ldflags = []
   configs = []
 
diff --git a/build/config/rust.gni b/build/config/rust.gni
index e98d9139f65a955b721401563439784f2f3a687b..aa26d86f8ba624df16385fe2a3f872e521cf209c 100644
--- a/build/config/rust.gni
+++ b/build/config/rust.gni
@@ -202,6 +202,8 @@ if (is_linux || is_chromeos) {
     rust_abi_target = "i686-unknown-linux-gnu"
   } else if (current_cpu == "x64") {
     rust_abi_target = "x86_64-unknown-linux-gnu"
+  } else if (current_cpu == "loong64") {
+    rust_abi_target = "loongarch64-unknown-linux-gnu"
   } else if (current_cpu == "arm") {
     if (arm_float_abi == "hard") {
       float_suffix = "hf"
@@ -302,6 +304,8 @@ if (current_cpu == "x86") {
   rust_target_arch = "powerpc64"
 } else if (current_cpu == "riscv64") {
   rust_target_arch = "riscv64"
+} else if (current_cpu == "loong64") {
+  rust_target_arch = "loongarch64"
 }
 
 assert(!toolchain_has_rust || rust_target_arch != "")
