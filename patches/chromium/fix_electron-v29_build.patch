support enable_rust

diff --git a/base/types/strong_alias.h b/base/types/strong_alias.h
index 9f80b7fc8adfb42282a3a3c1ee0203d7ca4ea4cb..4d28bd195c8ad0e205d6c32a965de638000d44c5 100644
